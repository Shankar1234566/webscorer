# WebScorer AI environment configuration
# Copy this file to `.env` and fill in the values you need. NEVER commit `.env`.

# ---------------------------------------------------------------------------
# AI copilot (optional)
# When WEBSCORER_AI_API_KEY is empty the backend answers in clearly labelled
# "local guidance" mode, built from the stored report. The key is only ever
# read by the Java backend - it is never sent to the React app.
# ---------------------------------------------------------------------------
WEBSCORER_AI_API_KEY=
WEBSCORER_AI_BASE_URL=https://api.openai.com/v1
WEBSCORER_AI_MODEL=gpt-4o-mini
WEBSCORER_AI_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Backend server
# ---------------------------------------------------------------------------
SERVER_PORT=8080
# Extra CORS origins on top of the dev defaults. Any http://localhost:* and
# http://127.0.0.1:* port is always allowed so the Vite dev server works even
# when it auto-increments past 5173; everything else is rejected with a JSON
# explanation. CORS only gates browser origins - the SSRF rules below are
# completely independent of it.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database (H2 file database by default - no setup required)
# ----------------------------------------------------------------------
DB_URL=jdbc:h2:file:./data/webscorer;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=

# To use MySQL instead, run with SPRING_PROFILES_ACTIVE=mysql and set:
#   DB_URL=jdbc:mysql://localhost:3306/webscorer?useSSL=false&serverTimezone=UTC
#   DB_USERNAME=webscorer
#   DB_PASSWORD=your-password

# ---------------------------------------------------------------------------
# Frontend (only needed when serving a built bundle from another origin)
# Leave empty in development - the Vite proxy forwards /api to localhost:8080.
# ---------------------------------------------------------------------------
VITE_API_BASE=
